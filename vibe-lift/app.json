{
  "expo": {
    "name": "Vibe Lift",
    "slug": "vibe-lift",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "vibelift",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b1120",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibelift.personal"
    },
    "android": {
      "package": "com.vibelift.personal",
      "adaptiveIcon": {
        "backgroundColor": "#0b1120"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
