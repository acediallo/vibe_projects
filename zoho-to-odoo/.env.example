# --- Zoho Invoice ---
# Create a self-client at https://api-console.zoho.com/ and generate a refresh
# token with scopes: ZohoInvoice.fullaccess.all
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data-center domain for your Zoho account: com, eu, in, com.au, jp, ca, sa
ZOHO_DC=com
ZOHO_ORGANIZATION_ID=

# --- Odoo ---
# For odoo.com online instances URL is https://<db>.odoo.com and DB is <db>
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany
ODOO_USERNAME=admin@example.com
# Use an API key from user preferences (recommended) or the account password
ODOO_API_KEY=

# --- Behavior ---
# Comma-separated list of resources to migrate. Order matters (dependencies).
# Available: contacts,items,invoices,credit_notes,payments
MIGRATE=contacts,items,invoices,credit_notes,payments
# Set to 1 to skip any Zoho document dated before this ISO date (YYYY-MM-DD)
MIGRATE_SINCE=
# Set to 1 to only fetch and log what would be done
DRY_RUN=0
